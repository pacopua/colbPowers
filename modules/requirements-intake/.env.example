# Azure Speech (batch transcription with diarization)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_LANGUAGE=es-ES

# Azure Blob Storage (audio uploads, job results, transcripts)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=speech-issues

# Cheap model: Azure OpenAI (filters transcript chunks)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Strong model: Google Gemini (research plan, architecture plan, issues)
GOOGLE_API_KEY=

# Web research
TAVILY_API_KEY=

# GitHub issue sync
GITHUB_TOKEN=

# Optional: LangSmith tracing
LANGCHAIN_API_KEY=
